{
    "qwen-2.5-7b": {
      "repo": "Qwen/Qwen2.5-7B-Instruct",
      "description": "Qwen 2.5 7B Instruct model"
    },
    "qwen-3-8b": {
      "repo": "Qwen/Qwen3-8B",
      "description": "Qwen 3 8B model (paper config: non-thinking mode)",
      "chat_template_kwargs": {"enable_thinking": false}
    },
    "qwen-3-4b": {
      "repo": "Qwen/Qwen3-4B",
      "description": "Qwen 3 4B model (paper config: non-thinking mode)",
      "chat_template_kwargs": {"enable_thinking": false}
    },
    "qwen-3-32b": {
      "repo": "Qwen/Qwen3-32B",
      "description": "Qwen 3 32B (dense), non-thinking mode",
      "chat_template_kwargs": {"enable_thinking": false},
      "sampling": {
        "do_sample": true,
        "temperature": 0.7,
        "top_p": 0.8,
        "top_k": 20,
        "min_p": 0.0
      }
    },
    "qwen-3-32b-thinking": {
      "repo": "Qwen/Qwen3-32B",
      "description": "Qwen 3 32B (dense), thinking mode (T=0.6, top_p=0.95 per Qwen recommendation)",
      "chat_template_kwargs": {"enable_thinking": true},
      "sampling": {
        "do_sample": true,
        "temperature": 0.6,
        "top_p": 0.95,
        "top_k": 20,
        "min_p": 0.0
      }
    },
    "r1-distilled-qwen-7b": {
      "repo": "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B",
      "description": "R1 distilled Qwen 7B model"
    },
    "llama-3.1-8b": {
      "repo": "meta-llama/Meta-Llama-3.1-8B-Instruct",
      "description": "LLaMA 3.1 8B model"
    },
    "gemma-3-27b": {
      "repo": "google/gemma-3-27b-it",
      "description": "Gemma 3 27B IT (HF default sampling)"
    },
    "gemma-3-4b": {
      "repo": "google/gemma-3-4b-it",
      "description": "Gemma 3 4B model"
    },
    "gpt-oss-20b": {
      "repo": "openai/gpt-oss-20b",
      "description": "GPT-OSS 20B (harmony format, reasoning_effort=medium)",
      "chat_template_kwargs": {"reasoning_effort": "medium"},
      "sampling": {
        "do_sample": true,
        "temperature": 1.0,
        "top_p": 1.0
      }
    },
    "gpt-oss-120b": {
      "repo": "openai/gpt-oss-120b",
      "description": "GPT-OSS 120B model"
    }
}
